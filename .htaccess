# J & S Tots Pre-School — Hostinger (LiteSpeed/Apache)
# Every block is wrapped in <IfModule> so a module the host does not load
# makes the directive inert rather than throwing a 500.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------------------------------------------------------------- redirects
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Git deployment copies the whole repository into public_html, so the clone's
  # own .git directory can land here too. Serving it would hand out the entire
  # history. Deny it before anything else in this file runs.
  RewriteRule (^|/)\.(git|github)(/|$) - [F,L]

  # one address for the site: https, no www — which is what the canonical
  # tags and the sitemap both say
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://jandstots.site%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.jandstots\.site$ [NC]
  RewriteRule ^ https://jandstots.site%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------- errors
ErrorDocument 404 /404.html

# -------------------------------------------------------------- mime types
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/xml .xml
</IfModule>

# -------------------------------------------------------------- compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # webp and jpeg are already compressed; running deflate over them costs CPU
  # and saves nothing
</IfModule>

# ------------------------------------------------------------------ caching
<IfModule mod_expires.c>
  ExpiresActive On
  # the pictures and the logo are versioned by name, so they can sit a year
  ExpiresByType image/webp    "access plus 1 year"
  ExpiresByType image/jpeg    "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  # The stylesheet and the script must revalidate rather than sit in a cache.
  # The HTML is no-cache, so a page goes live the moment it deploys -- while a
  # day-old stylesheet carried on styling it. New markup, old rules, for up to
  # 24 hours, which is how a fix can be correct on the server and invisible in
  # the browser. Revalidating costs one conditional request that answers 304
  # when nothing has changed, and keeps the two in step.
  ExpiresByType text/css               "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  # html must never be stale, or a change you push is invisible
  ExpiresByType text/html     "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# -------------------------------------------------- not part of the website
# These deploy with the repository but are development files, not pages. They
# hold nothing secret; they simply have no business being fetchable.
<FilesMatch "^(server\.js|README\.md|CNAME|\.gitignore|\.nojekyll|\.ftp-deploy-sync-state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
